{
  "entities": {
    "Receipt": {
      "title": "Receipt",
      "description": "A receipt generated by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "receiptNumber": { "type": "number" },
        "amountDinar": { "type": "string" },
        "amountDollar": { "type": "string" },
        "date": { "type": "string" },
        "building": { "type": "string" },
        "apartmentNumber": { "type": "string" },
        "receivedFrom": { "type": "string" },
        "amountText": { "type": "string" },
        "forMonth": { "type": "string" },
        "createdAt": { "type": "number", "description": "Server timestamp" }
      },
      "required": ["userId", "receiptNumber", "date", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer/tenant stored for auto-suggestion and records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "building": { "type": "string" },
        "apartmentNumber": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "UserCounter": {
      "title": "User Counter",
      "description": "Counter for the user's receipt numbers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastReceiptNumber": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "lastReceiptNumber", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Collection of receipts owned by a specific user."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Collection of customers/tenants owned by a specific user."
    },
    "/users/{userId}/counters/receiptCounter": {
      "schema": { "$ref": "#/entities/UserCounter" },
      "description": "Counter keeping track of the last receipt number for a user."
    }
  }
}
